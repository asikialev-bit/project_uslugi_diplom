# Режим работы приложения (development / production)
APP_ENV=development

# Путь к локальной базе данных SQLite
DATABASE_URL=sqlite:///./data/app.db

# Секретный ключ для подписи одноразовых кодов и токенов сессий (в production задать длинную случайную строку)
AUTH_SECRET=change-me-in-production

# Настройки внешнего SMTP для отправки одноразовых кодов входа (опционально; без них коды выводятся в консоль)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Настройки внешнего OpenAI-совместимого LLM API (заполняются локально в .env)
# Для Yandex AI Studio: LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1 и LLM_MODEL=gpt://<folder_id>/yandexgpt-lite/latest
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Настройки официального поискового API для поиска конкурентов (опционально)
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
